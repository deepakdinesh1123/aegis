# The ID of your GitHub App
APP_ID=
WEBHOOK_SECRET=development

# Paste the full PEM from the GitHub App settings (including BEGIN/END lines).
# Multiline value works if wrapped in double quotes.
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new set this to the URL that you are redirected to.
# Pointed at the webhook service (queuing Lambda), not the worker.
WEBHOOK_PROXY_URL=

# Listen on all interfaces when running in Docker
HOST=0.0.0.0

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE_NAME=pull-request-state

# ElasticMQ (local) / SQS
# webhook service: enqueue only
# worker service: SQS-triggered processor
SQS_ENDPOINT=http://elasticmq:9324
SQS_QUEUE_URL=http://elasticmq:9324/queue/aegis-events

# Worker mergeability deferral
MAX_MERGEABILITY_QUEUE_ATTEMPTS=5
