# Copy this file to .env and fill in real values. .env is gitignored.
#
# These become plaintext Lambda environment variables in this first
# pass — fine for getting the pipeline working, but move to AWS
# Secrets Manager before treating this as a real production setup.

APP_ID=4917886

# Paste the full PEM, BEGIN/END lines included, wrapped in double
# quotes so the newlines are preserved.
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

WEBHOOK_SECRET=development
